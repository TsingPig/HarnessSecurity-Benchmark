# Python-source harnesses use a pinned Python 3.11 virtualenv. Carry that
# interpreter and source tree with the installed environment instead of
# rebuilding the harness and resolving its dependencies for every task.
ARG HARNESS_RUNTIME_IMAGE=node:22-bookworm-slim
ARG BASE=node:22-bookworm-slim
FROM ${HARNESS_RUNTIME_IMAGE} AS pinned_harness
FROM ${BASE}

COPY --from=python:3.11-slim /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
ARG UBUNTU_MIRROR=
ARG APT_PACKAGES=
ENV DEBIAN_FRONTEND=noninteractive

RUN find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) -exec sed -i 's|http://|https://|g' {} + \
 && if [ -n "$UBUNTU_MIRROR" ]; then find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) -exec sed -i "s|https://archive.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g; s|https://security.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" {} +; fi \
 && apt-get -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 -o Acquire::Retries=1 -o APT::Update::Error-Mode=any update \
 && apt-get -o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 -o Acquire::Retries=1 install -y --no-install-recommends python3 python3-venv python3-pytest git ca-certificates bubblewrap ${APT_PACKAGES} \
 && rm -rf /var/lib/apt/lists/*

COPY --from=pinned_harness /opt/agent /opt/agent
COPY --from=pinned_harness /opt/agent-source /opt/agent-source
COPY --from=pinned_harness /opt/launch /opt/launch
COPY --from=pinned_harness /usr/local/bin/node /usr/local/bin/node
COPY --from=pinned_harness /usr/local/lib/node_modules/npm /opt/npm
COPY --from=pinned_harness /usr/bin/python3.11 /opt/python-runtime/bin/python3.11
COPY --from=pinned_harness /usr/lib/python3.11 /opt/python-runtime/lib/python3.11
RUN ln -sf /opt/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -sfn /opt/python-runtime/bin/python3.11 /opt/agent/bin/python3 \
 && sed -i 's|^home = .*|home = /opt/python-runtime/bin|; s|^executable = .*|executable = /opt/python-runtime/bin/python3.11|' /opt/agent/pyvenv.cfg

ARG EXECUTABLE
ENV PATH="/opt/launch/bin:/opt/agent/node_modules/.bin:${PATH}"
RUN "$EXECUTABLE" --version
