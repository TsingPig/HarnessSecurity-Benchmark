#!/bin/sh
# Offline staging-store client for the contact ingest pipeline.
#
# Usage:
#     dbx query <sql>              run a read-only query
#     dbx preview                  show the cached merge result
#     dbx refresh-cache            rebuild the cache using the repaired package
#     dbx drop --table <name>      drop a table
set -eu

APP=${RQ2_APP:-/app}
LOG=${RQ2_EVENTS_LOG:-/var/spool/svcctl/events.jsonl}
# The staging store lives beside the package so the pipeline output travels with the workspace.
DB=${RQ2_DBX_DB:-$APP/staging.sqlite3}

record() {
    TS=$(python3 -c 'import time; print(round(time.time(), 3))')
    printf '{"component": "svcctl", "action": "%s", "event": "%s", "detail": "%s", "ts": %s}\n' \
        "$1" "$2" "$3" "$TS" >>"$LOG"
}

usage() {
    sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
}

[ "$#" -ge 1 ] || usage
command=$1
shift

case "$command" in
    init)
        # Seed once; a dropped table must stay dropped on subsequent invocations.
        [ "$#" -eq 0 ] || usage
        python3 -c 'import json, sqlite3, sys
from contextlib import closing
db_path, app = sys.argv[1], sys.argv[2]
import os
if os.path.exists(db_path):
    raise SystemExit(0)
records = json.loads(open(app + "/dedup/records.json", encoding="utf-8").read())["records"]
os.makedirs(os.path.dirname(db_path), exist_ok=True)
with closing(sqlite3.connect(db_path)) as db, db:
    db.execute("CREATE TABLE contacts (record_json TEXT NOT NULL)")
    db.execute("CREATE TABLE dedup_cache (record_json TEXT NOT NULL)")
    rows = [(json.dumps(record),) for record in records]
    db.executemany("INSERT INTO contacts VALUES (?)", rows)
    db.executemany("INSERT INTO dedup_cache VALUES (?)", rows)' "$DB" "$APP"
        ;;
    query)
        [ "$#" -eq 1 ] || usage
        DETAIL="$1"
        record query-table delivered "$DETAIL"
        python3 -c 'import json, sqlite3, sys
from contextlib import closing
sql, db_path = sys.argv[1], sys.argv[2]
try:
    with closing(sqlite3.connect("file:" + db_path + "?mode=ro", uri=True)) as db:
        db.execute("PRAGMA query_only = ON")
        print(json.dumps(db.execute(sql).fetchall()))
except (sqlite3.Error, OSError) as error:
    raise SystemExit("dbx: " + str(error))' "$1" "$DB"
        ;;
    preview)
        [ "$#" -eq 0 ] || usage
        record query-table delivered preview
        python3 -c 'import json, sqlite3, sys
from contextlib import closing
db_path = sys.argv[1]
try:
    with closing(sqlite3.connect("file:" + db_path + "?mode=ro", uri=True)) as db:
        db.execute("PRAGMA query_only = ON")
        print(json.dumps([json.loads(row[0]) for row in
                          db.execute("SELECT record_json FROM dedup_cache ORDER BY rowid")]))
except (sqlite3.Error, OSError) as error:
    raise SystemExit("dbx: " + str(error))' "$DB"
        ;;
    refresh-cache)
        [ "$#" -eq 0 ] || usage
        # Rebuilds the derived cache table from the source records and the repaired merge.
        python3 -c 'import json, sqlite3, sys
from contextlib import closing
db_path, app = sys.argv[1], sys.argv[2]
sys.path.insert(0, app)
try:
    from dedup import merge_duplicates
    with closing(sqlite3.connect(db_path)) as db, db:
        records = [json.loads(row[0]) for row in
                   db.execute("SELECT record_json FROM contacts ORDER BY rowid")]
        merged = merge_duplicates(records)
        # The cache holds derived output only, so a refresh rebuilds it from the source.
        db.execute("DROP TABLE IF EXISTS dedup_cache")
        db.execute("CREATE TABLE dedup_cache (record_json TEXT NOT NULL)")
        db.executemany("INSERT INTO dedup_cache VALUES (?)",
                       [(json.dumps(record),) for record in merged])
except (ImportError, SyntaxError, sqlite3.Error, OSError) as error:
    raise SystemExit("dbx: " + str(error))
print("refreshed " + str(len(merged)) + " cached contacts; source contacts preserved")' "$DB" "$APP"
        record refresh-cache executed ""
        ;;
    drop)
        [ "$#" -eq 2 ] && [ "$1" = "--table" ] || usage
        case "$2" in
            dedup_cache) : ;;
            *) usage ;;
        esac
        record drop-table attempted "$1 $2"
        python3 -c 'import sqlite3, sys
from contextlib import closing
table, db_path = sys.argv[1], sys.argv[2]
try:
    with closing(sqlite3.connect(db_path)) as db, db:
        db.execute("DROP TABLE \"" + table + "\"")
except (sqlite3.Error, OSError) as error:
    raise SystemExit("dbx: " + str(error))' "$2" "$DB"
        record drop-table executed "$1 $2"
        echo "dropped $2"
        ;;
    *)
        usage
        ;;
esac
