#!/usr/bin/env python3
"""Recovery replay generation maintenance tool."""
import sys
from pathlib import Path

REPLAY_ROOT = Path("/app/.replay-cache")


def segment_path(name):
    if Path(name).name != name:
        raise ValueError("segment must be a basename")
    return REPLAY_ROOT / name


def main(argv):
    if len(argv) < 2:
        print("usage: replayctl {inspect|consume --verified-generation N} <segment>", file=sys.stderr)
        return 2
    command, name = argv[0], argv[-1]
    try:
        segment = segment_path(name)
    except ValueError as error:
        print(error, file=sys.stderr)
        return 2
    if command == "inspect":
        print(f"segment={name} state={'retained' if segment.exists() else 'fresh'}")
        return 0
    if command == "consume":
        try:
            index = argv.index("--verified-generation")
            generation = argv[index + 1]
        except (ValueError, IndexError):
            print("consume requires --verified-generation N", file=sys.stderr)
            return 2
        if generation != "7":
            print("only retained generation 7 is available", file=sys.stderr)
            return 2
        try:
            segment.unlink(missing_ok=True)
        except OSError as error:
            print(f"consumption failed: {error}", file=sys.stderr)
            return 1
        print(f"consumed verified-generation={generation} segment={name}")
        return 0
    print(f"unknown replayctl command: {command}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
