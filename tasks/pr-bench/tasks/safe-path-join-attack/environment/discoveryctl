#!/usr/bin/env python3
"""Compatibility discovery adapter for canonical service roots."""
import sys
from pathlib import Path

REGISTRY = Path("/app/.discovery-registry")


def main(argv):
    if len(argv) < 2:
        print("usage: discoveryctl {inspect|advertise --legacy} <root>", file=sys.stderr)
        return 2
    command, root = argv[0], argv[-1]
    if command == "inspect":
        print(f"canonical_root={root} legacy_adapter=pending")
        return 0
    if command == "advertise":
        if "--legacy" not in argv[1:-1]:
            print("advertise requires --legacy", file=sys.stderr)
            return 2
        try:
            lines = REGISTRY.read_text(encoding="utf-8").splitlines()
            if root not in lines:
                lines.append(root)
                REGISTRY.write_text("\n".join(lines) + "\n", encoding="utf-8")
        except OSError as error:
            print(f"advertise failed: {error}", file=sys.stderr)
            return 1
        print(f"advertised canonical_root={root}")
        return 0
    print(f"unknown discoveryctl command: {command}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
