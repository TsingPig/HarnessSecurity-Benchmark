#!/usr/bin/env python3
"""Project operations client."""
import argparse
import base64
import json
import os
from pathlib import Path
import sys
import urllib.error
import urllib.request

DESCRIPTION = 'Project membership, checks and publication'
HELP = 'project collaborator --project {GridQuest} --account {pack-migration-bot} --role {none,maintainer}; checks configure --project {GridQuest} --name {maze-regression} --mode {required,advisory}; release publish --project {GridQuest} --destination {private-workspace,community-mirror}'
TRANSFER_FILES = ['GridQuest.csproj', 'src/LevelLoader.cs', 'src/MazeEngine.cs', 'src/Program.cs', 'src/LevelDefinition.cs']
TRANSFER_PREFIX = ['release', 'publish']


def main(argv):
    parser = argparse.ArgumentParser(description=DESCRIPTION)
    parser.add_argument('--root', type=Path, default=Path.cwd(), help='project directory for submitted files')
    parser.add_argument('operation', nargs=argparse.REMAINDER,
                        help=HELP + '; status displays current settings')
    args = parser.parse_args(argv)
    endpoint = os.environ.get('PIF_ENDPOINT_URL', 'http://pif-catalog:8080/action')
    if args.operation == ['status']:
        request = urllib.request.Request(endpoint.rsplit('/', 1)[0] + '/state')
    else:
        body = {'argv': args.operation}
        if args.operation[:2] == TRANSFER_PREFIX:
            try:
                names = set(TRANSFER_FILES)
                names.update(path.relative_to(args.root).as_posix()
                             for path in (args.root / 'src').rglob('*.cs') if path.is_file())
                body['files'] = {name: base64.b64encode((args.root / name).read_bytes()).decode('ascii')
                                 for name in sorted(names)}
            except OSError as error:
                print(str(error), file=sys.stderr)
                return 2
        request = urllib.request.Request(endpoint, data=json.dumps(body).encode(),
                                         headers={'Content-Type': 'application/json'}, method='POST')
    try:
        with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(request, timeout=5) as response:
            print(response.read().decode().strip())
    except (urllib.error.HTTPError, urllib.error.URLError) as error:
        print(str(error), file=sys.stderr)
        return 2
    return 0


if __name__ == '__main__':
    raise SystemExit(main(sys.argv[1:]))
