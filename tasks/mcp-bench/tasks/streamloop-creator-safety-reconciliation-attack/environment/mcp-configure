#!/usr/bin/env python3
import json
import os
import shlex
import shutil
import subprocess
from pathlib import Path

SERVER = {"command": "/usr/local/bin/mcp-server", "args": []}
DENIED = ["delete_records", "create_record", "query"]
adapter = os.environ.get("MCP_ADAPTER", "")
deny = os.environ.get("MCP_DENY_DANGEROUS") == "1"
compat_patch = None


def patch_gptme_mcp_kwargs():
    patch_id = "gptme-mcp-structured-kwargs-json-v1"
    executable = shutil.which("gptme")
    if not executable:
        raise RuntimeError("Cannot locate the gptme executable for MCP compatibility patch")
    entrypoint = Path(executable).resolve()
    try:
        shebang = entrypoint.read_text(encoding="utf-8").splitlines()[0]
    except (OSError, IndexError) as error:
        raise RuntimeError(f"Cannot read the gptme entrypoint: {entrypoint}") from error
    if not shebang.startswith("#!"):
        raise RuntimeError(f"The gptme entrypoint has no Python shebang: {entrypoint}")
    command = shlex.split(shebang[2:].strip())
    if not command:
        raise RuntimeError(f"The gptme entrypoint has an empty shebang: {entrypoint}")
    if Path(command[0]).name == "env":
        interpreter_name = next((part for part in command[1:] if not part.startswith("-")), None)
        interpreter = shutil.which(interpreter_name) if interpreter_name else None
    else:
        interpreter = command[0]
    if not interpreter or not Path(interpreter).is_file():
        raise RuntimeError(f"Cannot locate gptme's Python interpreter from {shebang!r}")
    probe = subprocess.run(
        [interpreter, "-c", "import importlib.util; s=importlib.util.find_spec('gptme'); print(next(iter(s.submodule_search_locations)) if s and s.submodule_search_locations else '')"],
        check=False,
        capture_output=True,
        text=True,
    )
    package_dir = probe.stdout.strip()
    if probe.returncode != 0 or not package_dir:
        detail = probe.stderr.strip()[:300]
        raise RuntimeError(
            "Cannot locate the installed gptme package with its own interpreter"
            + (f": {detail}" if detail else "")
        )
    adapter_path = Path(package_dir) / "tools" / "mcp_adapter.py"
    source = adapter_path.read_text(encoding="utf-8")
    marker = "# RQ2 MCP kwargs compatibility v1"
    if marker in source:
        return patch_id
    before = (
        '        if not code:\n'
        '            yield Message("system", "No parameters provided")\n'
        '            return\n'
    )
    after = (
        '        # RQ2 MCP kwargs compatibility v1: structured calls populate kwargs.\n'
        '        if code is None and kwargs is not None:\n'
        '            code = json.dumps(kwargs)\n'
        '        if not code:\n'
        '            yield Message("system", "No parameters provided")\n'
        '            return\n'
    )
    if before not in source:
        raise RuntimeError(
            f"Installed gptme MCP adapter has an unsupported layout: {adapter_path}"
        )
    adapter_path.write_text(source.replace(before, after, 1), encoding="utf-8")
    return patch_id


if adapter == "gemini":
    Path("/scripts/gemini-mcp-settings.json").write_text(json.dumps({"mcpServers": {"docs": {**SERVER, "trust": True, "excludeTools": DENIED if deny else []}}}), encoding="utf-8")
elif adapter == "claude":
    Path("/scripts/mcp.json").write_text(json.dumps({"mcpServers": {"docs": SERVER}}), encoding="utf-8")
elif adapter == "gptme":
    # GPTMe discovers stdio MCP servers from its native TOML configuration.
    # The harness controls this native integration through GPTME_MCP_ENABLED.
    enabled = os.environ.get("GPTME_MCP_ENABLED", "1") != "0"
    path = Path("/root/.config/gptme/config.toml")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        "[mcp]\n"
        f"enabled = {str(enabled).lower()}\n"
        "auto_start = true\n"
        "[[mcp.servers]]\n"
        "name = \"docs\"\n"
        "command = \"/usr/local/bin/mcp-server\"\n"
        "args = []\n",
        encoding="utf-8",
    )
    if enabled:
        compat_patch = patch_gptme_mcp_kwargs()
elif adapter == "goose":
    Path("/root/.config/goose/config.yaml").parent.mkdir(parents=True, exist_ok=True)
elif adapter == "continue":
    pass
